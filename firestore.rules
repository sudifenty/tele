rules_version = '2';

// Tele security rules (Firestore).
//
// Family scoping: every family's data sits under families/{familyId}. A signed-in user
// can only read or write a family if their uid is in that family's parentUids list.
// A parent's own pointer (parents/{uid}.familyId) can only name a family they belong to.
//
// Child phones sign in anonymously. A child phone can write only to the device record it
// created with a valid pairing code, and only read its own device. It can't read other families.
//
// Parents cannot edit calls, texts, location or SOS records. Those are written only by the child's phone.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // True if the signed-in user is a parent in family {fid}.
    function isParentOf(fid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.parentUids;
    }

    // True if the signed-in user is the anonymous owner of device {did} in family {fid}.
    function isOwnerOfDevice(fid, did) {
      return signedIn()
        && get(/databases/$(database)/documents/families/$(fid)/devices/$(did)).data.ownerUid == request.auth.uid;
    }

    // A parent's own pointer. The family must already exist and must list this parent.
    // (The web dashboard creates the family first, then this record.)
    match /parents/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.familyId is string
        && request.auth.uid in get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.parentUids;
      allow delete: if false;
    }

    match /families/{fid} {
      // Create a family only as its first parent.
      allow create: if signedIn()
        && request.resource.data.parentUids == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow read: if isParentOf(fid);
      // Parents can rename the family. The parent list cannot be changed here.
      allow update: if isParentOf(fid)
        && request.resource.data.parentUids == resource.data.parentUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if false;

      match /devices/{did} {
        allow read: if isParentOf(fid) || isOwnerOfDevice(fid, did);

        // A child links itself with a valid, unexpired pairing code. The device is owned by its anonymous uid.
        allow create: if signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && exists(/databases/$(database)/documents/pairings/$(request.resource.data.pairingCode))
          && get(/databases/$(database)/documents/pairings/$(request.resource.data.pairingCode)).data.familyId == fid
          && get(/databases/$(database)/documents/pairings/$(request.resource.data.pairingCode)).data.expiresAt > request.time;

        // Parent edits labels, the SOS contact, alert threshold and the location switch.
        // The child edits only its status fields.
        allow update: if (isParentOf(fid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label', 'sosContactPhone', 'alertThreshold', 'locationSharing']))
          || (isOwnerOfDevice(fid, did)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastSeen', 'defaultSms', 'appVersion', 'permissions']));

        allow delete: if isParentOf(fid);

        match /calls/{callId} {
          allow read: if isParentOf(fid) || isOwnerOfDevice(fid, did);
          allow create, update: if isOwnerOfDevice(fid, did)
            && request.resource.data.keys().hasAll(['id', 'number', 'ts', 'type']);
        }

        // SMS: the body must be null unless the child's phone reports bodyVisible == true.
        match /sms/{smsId} {
          allow read: if isParentOf(fid) || isOwnerOfDevice(fid, did);
          allow create, update: if isOwnerOfDevice(fid, did)
            && request.resource.data.keys().hasAll(['id', 'address', 'ts', 'folder', 'body', 'bodyVisible'])
            && (request.resource.data.body == null || request.resource.data.bodyVisible == true);
        }

        // Live location. "current" is the latest point (drives the live view).
        match /location/{docId} {
          allow read: if isParentOf(fid) || isOwnerOfDevice(fid, did);
          allow create, update: if isOwnerOfDevice(fid, did)
            && request.resource.data.keys().hasAll(['lat', 'lng', 'ts'])
            && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
            && request.resource.data.lng >= -180 && request.resource.data.lng <= 180;
          allow delete: if false;
        }

        // Location history for the trail. expiresAt is used by a Firestore TTL policy (see README).
        match /locationHistory/{pointId} {
          allow read: if isParentOf(fid) || isOwnerOfDevice(fid, did);
          allow create: if isOwnerOfDevice(fid, did)
            && request.resource.data.keys().hasAll(['lat', 'lng', 'ts', 'expiresAt'])
            && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
            && request.resource.data.lng >= -180 && request.resource.data.lng <= 180;
          allow update: if false;
          allow delete: if isParentOf(fid);
        }

        match /sos/{sosId} {
          allow read: if isParentOf(fid) || isOwnerOfDevice(fid, did);
          allow create: if isOwnerOfDevice(fid, did);
          allow update: if isParentOf(fid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgedBy', 'acknowledgedAt']);
          allow delete: if false;
        }
      }
    }

    // Short-lived link codes. A parent creates one for their own family. A child reads one by its exact code.
    match /pairings/{code} {
      allow create: if signedIn()
        && isParentOf(request.resource.data.familyId)
        && request.resource.data.expiresAt is timestamp;
      allow get: if signedIn();
      allow list: if false;
      allow delete: if signedIn();
      allow update: if false;
    }
  }
}
